//						IMPOSTAZIONI GLOBALI

//attenzione se sbagli le preferenze base non viene visualizzato
//il menu

{
    "font_size": 16,                               // Dimensione del carattere dell'editor
    "tab_size": 3,                                 // Numero di spazi equivalenti a un tab
    "translate_tabs_to_spaces": true,              // Converte i tab in spazi
    "detect_indentation": false,                   // Importante: impedisce override automatico
    "word_wrap": false,                            // Disabilita l'andare a capo automatico
    "highlight_line": true,                        // Evidenzia la riga attiva
    "line_numbers": true,                          // Mostra i numeri di riga
    "gutter": true,                                // Mostra la colonna laterale (gutter)
    "theme": "Default Dark.sublime-theme",         // Tema dell'interfaccia utente
    "color_scheme": "Monokai.sublime-color-scheme",// Colori della sintassi del codice
    "ignored_packages": ["Vintage",
    ],               // Disattiva solo Vintage
    "auto_complete": true,                         // Attiva il completamento automatico
    "auto_save": true,                             // Salvataggio automatico dei file modificati
    "trim_trailing_white_space_on_save": true,     // Rimuove spazi finali al salvataggio
    "ensure_newline_at_eof_on_save": true,         // Aggiunge riga vuota finale
    "show_encoding": true,                         // Mostra la codifica del file
    "show_line_endings": true,                     // Mostra i caratteri di fine riga
    "index_files": true,                           // Mostra visivamente tutti gli spazi bianchi nel codice (spazi, tab, ecc.).
    "draw_white_space": "all",                     // Mostra spazi e tab
    "file_exclude_patterns": ["tmp*"],             // Nasconde i file che iniziano con tmp es. tmp, tmp123 temporaney_file.txt
    "folder_exclude_patterns": ["tmp*"],           // Nasconde le cartelle es temporanesi_folder, tmp, tmp123 ecc.
}
